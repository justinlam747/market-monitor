# ---- LLM ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ---- Web search / page reader ----
TAVILY_API_KEY=tvly-...

# ---- xAI Grok (X / Twitter competitor search) — optional ----
# When set, the agent uses Grok X Search to help discover competitors and pull
# recent X signals. If unset, the agent falls back to OpenAI + Tavily only.
XAI_API_KEY=xai-...
XAI_MODEL=grok-4.3

# ---- Database (Neon / Supabase cloud Postgres) ----
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Server ----
PORT=4000

# ---- Agent mode ----
# "live"    -> uses OpenAI + Tavily (+ Grok if XAI_API_KEY set)
# "fixture" -> uses bundled fixtures, no network/keys (used by tests)
AGENT_MODE=live
